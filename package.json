{
  "name": "ap-chinese-vocab",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx http-server site -p 8080 -c-1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:update-screenshots": "playwright test --grep @visual --update-snapshots",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
